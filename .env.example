# ── CodeNest environment variables ──────────────────────────────
# Copy this file to server/.env and fill in real values.
# NEVER commit server/.env to git (it is already in .gitignore).

# MongoDB (Atlas free tier): Atlas Dashboard → Connect → Drivers
# Standard format (use this on Render / most networks):
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/codenest?retryWrites=true&w=majority

# NOTE: if you get `querySrv ECONNREFUSED` on YOUR PC only (some home
# routers break SRV DNS lookups), use the direct-hosts format instead —
# Atlas → Connect → Drivers → "connection string for drivers that cannot
# resolve +srv", which looks like:
# MONGODB_URI=mongodb://USER:PASS@ac-xxx-shard-00-00.xxxxx.mongodb.net:27017,ac-xxx-shard-00-01.xxxxx.mongodb.net:27017,ac-xxx-shard-00-02.xxxxx.mongodb.net:27017/codenest?tls=true&authSource=admin&retryWrites=true&w=majority

# Google Gemini API key — free from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here

# Any current flash model; the server auto-falls-back if one is overloaded
GEMINI_MODEL=gemini-3.6-flash

# Long random string used to sign login tokens (any random 40+ chars)
JWT_SECRET=change_me_to_a_long_random_string

# Port the server runs on (Render sets this automatically)
PORT=5000
